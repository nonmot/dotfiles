{
  "env": {
    "EDITOR": "nvim",
    "VISUAL": "nvim"
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "PIXTUOID_SOURCE=claude-code 'pixtuoid-hook'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "PIXTUOID_SOURCE=claude-code 'pixtuoid-hook'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "PIXTUOID_SOURCE=claude-code 'pixtuoid-hook'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "PIXTUOID_SOURCE=claude-code 'pixtuoid-hook'"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "PIXTUOID_SOURCE=claude-code 'pixtuoid-hook'"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "PIXTUOID_SOURCE=claude-code 'pixtuoid-hook'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "PIXTUOID_SOURCE=claude-code 'pixtuoid-hook'"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "PIXTUOID_SOURCE=claude-code 'pixtuoid-hook'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "example-skills@anthropic-agent-skills": true,
    "drawio@drawio": true
  },
  "extraKnownMarketplaces": {
    "drawio": {
      "source": {
        "source": "github",
        "repo": "jgraph/drawio-mcp"
      }
    }
  },
  "skipWorkflowUsageWarning": true,
  "theme": "light"
}
